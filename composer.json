{
    "name": "ftelf/netprovider",
    "description": "PHP ISP billing and network management system",
    "type": "project",
    "license": "LGPL-2.1-only",
    "require": {
        "php": ">=8.1",
        "ext-mysqli": "*",
        "ext-mbstring": "*",
        "ext-gettext": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6",
        "phpunit/php-code-coverage": "^10.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration",
        "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-html=build/coverage --coverage-text",
        "test:testdox": "phpunit --testdox"
    }
}
